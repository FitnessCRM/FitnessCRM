# Copia este archivo a .env.local y rellénalo. .env* no se commitea.

# Qué backend monta la app: `firebase` para el real; sin valor, el adaptador en memoria con la demo.
NEXT_PUBLIC_DATA_BACKEND=

# Configuración web de Firebase (no es secreta: la protegen las reglas de seguridad).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Para desarrollar contra los emuladores locales en vez del proyecto real (`127.0.0.1`): con esto
# no hacen falta las claves de arriba. Arráncalos con `firebase emulators:start --project demo-hector`.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
# Proyecto de los emuladores; `demo-hector` si no se dice.
NEXT_PUBLIC_FIREBASE_EMULATOR_PROJECT_ID=
