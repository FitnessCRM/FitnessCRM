# Copia este archivo a .env.local y rellénalo. .env* no se commitea.

# Qué backend monta la app: `supabase` o `firebase`; sin valor, el adaptador en memoria con la demo.
NEXT_PUBLIC_DATA_BACKEND=

# Solo con el adaptador en memoria: `true` simula que el catálogo común de alimentos no responde, y
# la biblioteca se queda con los alimentos propios. Sin valor, el catálogo responde.
NEXT_PUBLIC_MOCK_FOOD_CATALOG_DOWN=

# Configuración web de Firebase (no es secreta: la protegen las reglas de seguridad).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Para desarrollar contra los emuladores locales en vez del proyecto real (`127.0.0.1`): con esto
# no hacen falta las claves de arriba. Arráncalos con `firebase emulators:start --project demo-hector`.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
# Proyecto de los emuladores; `demo-hector` si no se dice.
NEXT_PUBLIC_FIREBASE_EMULATOR_PROJECT_ID=

# --- Supabase -------------------------------------------------------------------------------------
# URL y clave pública (anon) del proyecto. La anon no es secreta: la protege RLS. En local,
# `supabase start` las imprime (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para los tests del adaptador de Supabase contra la instancia local (`supabase start`).
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Solo para el cargador de la migración (`pnpm migrate:firebase:load`). La service role salta RLS:
# nunca en el navegador, en Vercel ni en el repo. Sin SUPABASE_URL, la instancia local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge Functions (secretos de Supabase, no de Vercel) -----------------------------------------
# No se leen desde Next: se fijan con `supabase secrets set` en el proyecto, o en
# `supabase/functions/.env` en local (fuera de git). SUPABASE_URL, SUPABASE_ANON_KEY y
# SUPABASE_SERVICE_ROLE_KEY las pone Supabase solo.
#
# Adónde vuelve el enlace de invitación (`/accept-invite` de la app).
INVITE_URL=
# URL pública de la app: a ella vuelven Stripe Checkout y el alta de la cuenta conectada.
APP_URL=

# Stripe, solo en modo test hasta que Dani decida lo contrario. Clave secreta de la plataforma
# (sk_test_…) y secreto de firma del webhook (whsec_…). Nunca en el repo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
